# ─────────────────────────────────────────────────────────────
# DSH website — environment variables
#
# Copy this file to `.env` and fill it in. `.env*` is gitignored;
# this example is the only one that gets committed, so never put a
# real value in here.
#
# Set the same names in Vercel → Project → Settings → Environment
# Variables. Anything missing here but present in Vercel is why the
# site works deployed and not on your machine.
#
# NEXT_PUBLIC_ inlines the value into the browser bundle. A secret
# with that prefix is a published secret.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# These two ARE public by design: the anon key is protected by
# row-level security, not by being secret.
# Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — bypasses every RLS policy. Server-side only.
# Needed to record donations: the donor is logged out, and `donations`
# is admin-only by RLS.
# Supabase dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────────
# Which of the pairs below is used is decided at runtime by
# `site_settings.stripe_mode`, set from the dashboard toggle — not by
# a deploy. The resolver refuses on a prefix mismatch rather than
# charging against the wrong account, so a live key pasted into the
# test slot fails loudly instead of quietly.
#
# Dashboard → Developers → API keys.

# Test mode.
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_WEBHOOK_SECRET_TEST=whsec_...

# Live mode. Leave empty until launch — the resolver will refuse to
# switch to live while these are blank, which is the intended guard.
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=

# Legacy single-key names. Still read as a fallback when the
# mode-specific pair above is absent. Prefer the pair; these exist so
# older deployments keep working.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# For local webhook testing:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# and use the signing secret it prints.

# ── Bunny CDN ────────────────────────────────────────────────
# The Stream pull-zone hostname, e.g. `dsh-video.b-cdn.net`.
# Used to build `.m3u8` playlist and thumbnail URLs for video.
# Bunny → Stream → your library → API → CDN Hostname
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME=

# The image pull zone, e.g. `dsh-media.b-cdn.net`.
#
# A pull zone whose ORIGIN is the Supabase Storage public URL:
#   https://your-project.supabase.co
# Bunny fetches each file once and serves every later request from an
# edge, so image bytes stop counting against Supabase egress — which
# is where the bill actually comes from.
#
# Leave this EMPTY to serve images straight from Supabase. That is the
# off switch: nothing else has to change, and no stored URL depends on
# it, because the rewrite happens when an image is read, not when it
# is uploaded.
NEXT_PUBLIC_BUNNY_IMAGE_CDN=

# ── Site ─────────────────────────────────────────────────────
# Used to build Stripe success/cancel return URLs.
#
# CAREFUL: `resolveSiteUrl()` prefers the domain the request actually
# arrived on, so leaving this UNSET is correct in production and means
# the domain change needs no configuration at all. An explicit value
# WINS over the request host — so a stale value here sends donors back
# to the wrong domain after paying, while checkout still appears to
# work. Set it locally, delete it in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
