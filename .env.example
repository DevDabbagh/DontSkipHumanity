# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. .env* is gitignored — never
# commit real keys, and never paste the secret key into chat,
# a ticket, or a Figma comment.
# ─────────────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — bypasses every RLS policy. Server-side only, never NEXT_PUBLIC_.
# Needed to record donations: the donor is logged out, and `donations` is
# admin-only by RLS. Supabase dashboard → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────────
# Dashboard → Developers → API keys. Use the TEST keys while the
# toggle in the Stripe dashboard says "Test mode".

# NOT NEEDED YET. We create the Checkout session server-side and redirect,
# so the browser never talks to Stripe directly. Only add this if we move to
# Stripe Elements / embedded checkout.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# SECRET — server-side only. Must NOT start with NEXT_PUBLIC_.
# If this ever leaks, roll it immediately in the Stripe dashboard.
STRIPE_SECRET_KEY=sk_test_...

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`,
# or Dashboard → Developers → Webhooks → signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Used to build success/cancel return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
